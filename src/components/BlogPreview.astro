---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { mediaExists } from '../utils/media';

import { advicePosts } from '../data/advicePosts.js';
const posts = [
  { title: 'Profesionalno dubinsko čišćenje hotela i poslovnih prostora', src: '/images/red-carpet-dubinsko-ciscenje-tepisona-hotel.webp', href: '/novosti/profesionalno-dubinsko-ciscenje-hotela-i-poslovnih-prostora/', type: 'novost' },
  ...advicePosts.map(post => ({ ...post, src: post.image, href: '/savjeti/' + post.slug + '/', type: 'savjet' }))
];
---

<section class="section section--light blog-preview" id="blog">
	<div class="container">
		<div class="section-heading">
			<h2>Savjeti i novosti</h2>
			<p><a href="/novosti/profesionalno-dubinsko-ciscenje-hotela-i-poslovnih-prostora/">Novo: Profesionalno dubinsko čišćenje hotela i poslovnih prostora →</a></p>
		</div>

		<div class="blog-preview__grid">
			{
				posts.map((post) => {
					const exists = mediaExists(post.src);
					return (
						<article class="blog-card"><a class="blog-card__link" href={post.href} aria-label={"Pročitaj " + post.type + ": " + post.title}>
							<div class="blog-card__media">
								{exists ? (
									<img src={post.src} alt={post.title} loading="lazy" decoding="async" width="480" height="320" />
								) : (
									<MediaPlaceholder
										title="FOTOGRAFIJA BLOGA"
										filename={post.src.replace('/images/', '')}
										dimensions="960 × 640 px"
										aspectRatio="3/2"
									/>
								)}
							</div>
							<h3>{post.title}</h3>
							<span class="blog-card__badge">{post.type === "novost" ? "Pročitaj novost →" : "Pročitaj savjet →"}</span>
						</a></article>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.blog-preview__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.blog-card {
		background: var(--white);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		display: flex;
		flex-direction: column;
	}

	.blog-card__link { color: inherit; text-decoration: none; display: flex; flex-direction: column; height: 100%; }
	.blog-card__link:hover h3 { color: var(--red); }
	.blog-card__media img {
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.blog-card h3 {
		color: var(--black);
		font-size: 1rem;
		padding: 1.25rem 1.25rem 0;
	}

	.blog-card__badge {
		margin: 0.85rem 1.25rem 1.25rem;
		display: inline-flex;
		align-self: flex-start;
		padding: 0.25rem 0.65rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--gray);
		border: 1px solid var(--border);
		border-radius: 999px;
	}

	@media (max-width: 1024px) {
		.blog-preview__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.blog-preview__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
