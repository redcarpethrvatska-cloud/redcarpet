---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const socialLinks = [
	{ name: 'YouTube', icon: 'youtube', href: 'https://www.youtube.com/@REDCARPET-sp6kx' },
	{ name: 'Facebook', icon: 'facebook', href: 'https://www.facebook.com/profile.php?id=61565206903287' },
	{ name: 'Instagram', icon: 'instagram', href: 'https://www.instagram.com/redcarpet.hr/' },
	{ name: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/igor-stazic-redcarpet/' },
	{ name: 'TikTok', icon: 'tiktok', href: 'https://www.tiktok.com/@redcarpet.hr' },
];
---

<section class="section contact" id="kontakt">
	<div class="container contact__grid">
		<div class="contact__info">
			<h2>Zatražite ponudu</h2>
			<p>
				Pošaljite nam osnovne informacije o objektu, lokaciji, približnoj kvadraturi ili broju
				komada namještaja. Po zaprimanju upita kontaktirat ćemo vas radi dogovora o opsegu i terminu.
			</p>

			<dl class="contact__details">
				<div>
					<dt>Telefon</dt>
					<dd><a href="tel:+385913393333">+385 91 339 3333</a></dd>
				</div>
				<div>
					<dt>E-mail</dt>
					<dd><a href="mailto:redcarpet.hrvatska@gmail.com">redcarpet.hrvatska@gmail.com</a></dd>
				</div>
				<div>
					<dt>Adresa</dt>
					<dd>Nova Cesta 24a, 51410 Opatija</dd>
				</div>
				<div>
					<dt>Područje rada</dt>
					<dd>Cijela Hrvatska</dd>
				</div>
				<div>
					<dt>Radno vrijeme</dt>
					<dd>Ponedjeljak – petak, 08:00–16:00</dd>
				</div>
			</dl>

			<ul class="contact__social" aria-label="Društvene mreže Red Carpet">
				{
					socialLinks.map((social) => (
						<li>
							<a
								href={social.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={social.name}
								title={social.name}
							>
								<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                  {social.icon === 'youtube' && <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.5 31.5 0 0 0 0 12a31.5 31.5 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.5 31.5 0 0 0 24 12a31.5 31.5 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/>}
                  {social.icon === 'facebook' && <path d="M15.6 8H13V6.3c0-.8.5-1 1-1h1.5V2.2c-.7-.1-1.5-.2-2.3-.2-2.8 0-4.6 1.7-4.6 4.8V8H6v3.7h2.6V22H13V11.7h2.4L15.6 8Z"/>}
                  {social.icon === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.5" cy="6.5" r="1.2"/></>}
                  {social.icon === 'linkedin' && <path d="M4.7 3a2.1 2.1 0 1 0 0 4.2 2.1 2.1 0 0 0 0-4.2ZM3 9h3.5v12H3V9Zm6 0h3.4v1.6c.6-1 1.7-1.9 3.5-1.9 3.8 0 4.1 2.5 4.1 5.8V21h-3.6v-5.8c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V21H9V9Z"/>}
                  {social.icon === 'tiktok' && <path d="M16.7 2c.3 2.3 1.7 3.7 4 3.9v3.7a9 9 0 0 1-4-1.2v6.1c0 4.1-3.1 7.1-7.1 7.1a7.1 7.1 0 0 1-2.9-13.5v4.2a3.4 3.4 0 1 0 5.8 2.3V2h4.2Z"/>}
                </svg>
							</a>
						</li>
					))
				}
			</ul>
		</div>

		<form class="contact__form" id="contact-form" novalidate>
			<div class="form-row">
				<label for="fullName">Ime i prezime <span aria-hidden="true">*</span></label>
				<input type="text" id="fullName" name="fullName" autocomplete="name" maxlength="120" required />
				<p class="form-error" id="fullName-error" role="alert" hidden></p>
			</div>

			<div class="form-row form-row--split">
				<div>
					<label for="company">Tvrtka ili objekt</label>
					<input type="text" id="company" name="company" autocomplete="organization" maxlength="160" required />
				</div>
				<div>
					<label for="city">Grad ili lokacija</label>
					<input type="text" id="city" name="city" autocomplete="address-level2" maxlength="120" required />
				</div>
			</div>

			<div class="form-row form-row--split">
				<div>
					<label for="phone">Telefon <span aria-hidden="true">*</span></label>
					<input type="tel" id="phone" name="phone" autocomplete="tel" required />
					<p class="form-error" id="phone-error" role="alert" hidden></p>
				</div>
				<div>
					<label for="email">E-mail</label>
					<input type="email" id="email" name="email" autocomplete="email" />
					<p class="form-error" id="email-error" role="alert" hidden></p>
				</div>
			</div>

			<div class="form-row">
				<label for="message">Kratka poruka</label>
				<textarea id="message" name="message" rows="4" maxlength="3000" required></textarea>
			</div>

			<div class="form-row form-row--checkbox">
				<input type="checkbox" id="gdpr" name="gdpr" required />
				<label for="gdpr">
					Potvrđujem da sam pročitao/la <a href="/privatnost">informacije o privatnosti</a> i želim da me kontaktirate u vezi s upitom.
					<span aria-hidden="true">*</span>
				</label>
				<p class="form-error" id="gdpr-error" role="alert" hidden></p>
			</div>

			<div class="form-row" hidden aria-hidden="true"><label for="website">Web</label><input id="website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
			{turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div> : <p class="form-error">Obrazac će biti aktivan nakon konfiguracije zaštite od spama. Do tada nam <a href="mailto:redcarpet.hrvatska@gmail.com?subject=B2B%20upit%20za%20ponudu">pošaljite e-mail</a>.</p>}
			<button type="submit" class="btn btn-primary contact__submit" disabled={!turnstileSiteKey}>Zatražite ponudu</button>

			<p class="contact__status" id="contact-status" role="status" aria-live="polite"></p>
            <p class="contact__fallback"><strong>Možete nam pisati i izravno:</strong> <a href="mailto:redcarpet.hrvatska@gmail.com?subject=Upit%20za%20B2B%20ciscenje">redcarpet.hrvatska@gmail.com</a>.</p>
		</form>
	</div>
</section>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
	.contact__grid {
		display: grid;
		grid-template-columns: 0.85fr 1.15fr;
		gap: 3rem;
	}

	.contact__info h2 {
		margin-bottom: 1.25rem;
	}

	.contact__details {
		margin-top: 2rem;
		display: grid;
		gap: 1.1rem;
	}

	.contact__details dt {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--red);
	}

	.contact__details dd {
		margin: 0.15rem 0 0;
		font-weight: 600;
		color: var(--black);
	}

	.contact__details a {
		text-decoration: none;
	}

	.contact__details a:hover {
		text-decoration: underline;
	}

	.contact__social {
		display: flex;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.contact__social a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--black);
		color: var(--white);
		font-weight: 700;
		text-decoration: none;
		transition: background-color 0.15s ease;
	}

	.contact__social svg {width:21px;height:21px;flex:none;color:var(--white)}
	.contact__social a:hover {
		background: var(--red);
	}

	.contact__form {
		background: var(--light-gray);
		border-radius: var(--radius);
		padding: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-row {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.form-row--split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.form-row--split > div {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	label {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--black);
	}

	input[type='text'],
	input[type='tel'],
	input[type='email'],
	textarea {
		width: 100%;
		padding: 0.7rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--white);
	}

	input[aria-invalid='true'],
	textarea[aria-invalid='true'] {
		border-color: var(--red);
	}

	textarea {
		resize: vertical;
	}

	.form-row--checkbox {
		flex-direction: row;
		flex-wrap: wrap;
		align-items: flex-start;
		gap: 0.65rem;
	}

	.form-row--checkbox input {
		margin-top: 0.25rem;
		flex: none;
		width: 18px;
		height: 18px;
	}

	.form-row--checkbox label {
		flex: 1;
		font-weight: 500;
		font-size: 0.9rem;
	}

	.form-error {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--red-dark);
	}

	.contact__submit {
		align-self: flex-start;
	}

	.contact__fallback {font-size:1rem;line-height:1.5;padding:.95rem 1rem;border-left:3px solid var(--red);background:#fff;color:var(--black)}
	.contact__fallback a{font-weight:700;text-decoration:underline;overflow-wrap:anywhere}
	.contact__status {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
	}

	.contact__status[data-state='success'] {
		color: var(--black);
	}

	@media (max-width: 900px) {
		.contact__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 560px) {
		.form-row--split {
			grid-template-columns: 1fr;
		}

		.contact__submit {
			align-self: stretch;
		}
	}
</style>

<script>
	const form = document.getElementById('contact-form');
	const status = document.getElementById('contact-status');

	if (form && status) {
		const fullName = document.getElementById('fullName');
		const phone = document.getElementById('phone');
		const email = document.getElementById('email');
		const gdpr = document.getElementById('gdpr');

		const setError = (field, errorId, message) => {
			const errorEl = document.getElementById(errorId);
			if (!errorEl) return;
			if (message) {
				errorEl.textContent = message;
				errorEl.hidden = false;
				field.setAttribute('aria-invalid', 'true');
				field.setAttribute('aria-describedby', errorId);
			} else {
				errorEl.textContent = '';
				errorEl.hidden = true;
				field.removeAttribute('aria-invalid');
			}
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			status.textContent = '';
			status.removeAttribute('data-state');

			let isValid = true;

			if (!fullName.value.trim()) {
				setError(fullName, 'fullName-error', 'Molimo unesite ime i prezime.');
				isValid = false;
			} else {
				setError(fullName, 'fullName-error', null);
			}

			const phoneDigits = phone.value.replace(/[^0-9+]/g, '');
			if (!phoneDigits || phoneDigits.length < 6) {
				setError(phone, 'phone-error', 'Molimo unesite ispravan broj telefona.');
				isValid = false;
			} else {
				setError(phone, 'phone-error', null);
			}

			if (email.value.trim() && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
				setError(email, 'email-error', 'Molimo unesite ispravnu e-mail adresu.');
				isValid = false;
			} else {
				setError(email, 'email-error', null);
			}

			if (!gdpr.checked) {
				setError(gdpr, 'gdpr-error', 'Potrebna je suglasnost za obradu podataka.');
				isValid = false;
			} else {
				setError(gdpr, 'gdpr-error', null);
			}

			if (!isValid) {
				status.textContent = 'Molimo provjerite označena polja.';
				status.setAttribute('data-state', 'error');
				return;
			}

	        const company = document.getElementById('company').value.trim();
        const city = document.getElementById('city').value.trim();
        const message = document.getElementById('message').value.trim();
        if (!company || !city || !message) {
          status.textContent = 'Tvrtka, grad i opis posla su obvezni.';
          status.setAttribute('data-state', 'error');
          return;
        }
        const token = form.querySelector('[name="cf-turnstile-response"]')?.value || '';
        if (!token) {
          status.textContent = 'Molimo dovršite sigurnosnu provjeru.';
          status.setAttribute('data-state', 'error');
          return;
        }
        const submit = form.querySelector('button[type="submit"]');
        submit.disabled = true;
        status.textContent = 'Šaljemo upit...';
        try {
          const response = await fetch('/api/inquiry', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
              fullName: fullName.value.trim(), company, city, phone: phone.value.trim(),
              email: email.value.trim(), message, gdpr: gdpr.checked,
              website: document.getElementById('website').value,
              turnstileToken: token
            })
          });
          const result = await response.json();
          if (!response.ok || !result.ok) throw new Error(result.error || 'Slanje nije uspjelo.');
          status.textContent = 'Upit je uspješno poslan.';
          if (typeof window.gtag === 'function') window.gtag('event', 'generate_lead', { lead_type: 'b2b_inquiry' });
          status.setAttribute('data-state', 'success');
          form.reset();
        } catch (error) {
          status.textContent = error.message || 'Slanje nije uspjelo. Pokušajte putem e-maila.';
          status.setAttribute('data-state', 'error');
        } finally {
          submit.disabled = false;
          window.turnstile?.reset();
        }
		});
	}
</script>
