---
const navItems = [
	{ label: 'Početna', href: '/' },
	{ label: 'B2B usluge', href: '/#usluge' },
	{ label: 'Industrije', href: '/#industrije' },
	{ label: 'Izvedeni radovi', href: '/izvedeni-radovi/' },
	{ label: 'O nama', href: '/#o-nama' },
	{ label: 'Kontakt', href: '/#kontakt' },
];
---

<header class="site-header">
	<div class="container site-header__inner">
		<a href="/" class="brand" aria-label="Red Carpet — početna stranica">
			<img class="brand__logo" src="/red-carpet-logo.svg" alt="Red Carpet – Professional Chemical Cleaning" width="780" height="140" />
		</a>

		<button
			type="button"
			class="nav-toggle"
			id="nav-toggle"
			aria-expanded="false"
			aria-controls="primary-navigation"
		>
			<span class="visually-hidden">Otvori izbornik</span>
			<span class="nav-toggle__bars" aria-hidden="true"></span>
		</button>

		<nav class="site-nav" id="primary-navigation" aria-label="Glavna navigacija">
			<ul class="site-nav__list">
				{
					navItems.map((item) => (
						<li>
							<a href={item.href}>{item.label}</a>
						</li>
					))
				}
			</ul>

			<div class="site-nav__actions">
				<a href="/#kontakt" class="btn btn-primary">Zatražite ponudu</a>
			</div>
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: var(--white);
		border-bottom: 1px solid var(--border);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1rem;
		max-width: 1400px;
	}

	.brand {
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		text-decoration: none;
		color: var(--black);
		line-height: 1.1;
		white-space: nowrap;
	}

	.brand__logo {width:clamp(175px,19vw,245px);height:auto;display:block}

	.brand__name {
		font-size: 1.55rem;
		font-weight: 800;
		letter-spacing: 0.03em;
	}

	.brand__tagline {
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: var(--red);
	}

	/* Nav toggle (mobile) */
	.nav-toggle {
		display: none;
		flex: none;
		width: 44px;
		height: 44px;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		cursor: pointer;
	}

	.nav-toggle__bars,
	.nav-toggle__bars::before,
	.nav-toggle__bars::after {
		display: block;
		width: 22px;
		height: 2px;
		background: var(--black);
		position: relative;
		transition: transform 0.15s ease, opacity 0.15s ease;
	}

	.nav-toggle__bars::before,
	.nav-toggle__bars::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.nav-toggle__bars::before {
		top: -7px;
	}

	.nav-toggle__bars::after {
		top: 7px;
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle__bars {
		background: transparent;
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle__bars::before {
		top: 0;
		transform: rotate(45deg);
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle__bars::after {
		top: 0;
		transform: rotate(-45deg);
	}

	/* Nav */
	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.5rem;
	}

	.site-nav__list a {
		display: inline-block;
		padding: 0.4rem 0.1rem;
		text-decoration: none;
		font-weight: 600;
		font-size: 1rem;
		color: var(--black);
		border-bottom: 2px solid transparent;
	}

	.site-nav__list a:hover {
		border-color: var(--red);
	}

	.site-nav__actions {
		display: flex;
		align-items: center;
		flex-shrink: 0;
		gap: 0.6rem;
	}

	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		font-size: 11.5px;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.lang-switch__option {
		color: var(--gray);
		padding: 0.1rem 0.2rem;
	}

	.lang-switch__option.is-active {
		color: var(--black);
		border-bottom: 2px solid var(--red);
	}

	.lang-switch__option.is-disabled {
		cursor: default;
		opacity: 0.5;
	}

	@media (min-width: 1360px) {
		.site-nav {
			display: flex;
			align-items: center;
			justify-content: flex-end;
			gap: 0.75rem;
			flex: 1;
			margin-left: 0.75rem;
		}
	}

	@media (max-width: 1359px) {
		.nav-toggle {
			display: inline-flex;
		}

		.site-nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: var(--white);
			border-bottom: 1px solid var(--border);
			padding: 1.25rem 1.5rem 1.75rem;
			display: none;
			flex-direction: column;
			align-items: stretch;
			gap: 1.25rem;
			box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
		}

		.site-header {
			position: relative;
		}

		.site-nav.is-open {
			display: flex;
		}

		.site-nav__list {
			flex-direction: column;
			gap: 0.25rem;
		}

		.site-nav__list a {
			display: block;
			padding: 0.6rem 0.1rem;
			border-bottom: 1px solid var(--border);
		}

		.site-nav__actions {
			flex-direction: column;
			align-items: stretch;
			gap: 1rem;
		}

		.lang-switch {
			justify-content: center;
		}

		.site-nav__actions .btn {
			width: 100%;
		}
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const nav = document.getElementById('primary-navigation');

	if (toggle && nav) {
		const closeMenu = () => {
			nav.classList.remove('is-open');
			toggle.setAttribute('aria-expanded', 'false');
		};

		const openMenu = () => {
			nav.classList.add('is-open');
			toggle.setAttribute('aria-expanded', 'true');
		};

		toggle.addEventListener('click', () => {
			const isOpen = nav.classList.contains('is-open');
			isOpen ? closeMenu() : openMenu();
		});

		nav.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', closeMenu);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeMenu();
		});

		const mediaQuery = window.matchMedia('(min-width: 1360px)');
		mediaQuery.addEventListener('change', (event) => {
			if (event.matches) closeMenu();
		});
	}
</script>
