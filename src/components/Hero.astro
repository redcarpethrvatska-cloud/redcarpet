---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { mediaExists } from '../utils/media';

const heroSrc = '/images/profesionalno-ciscenje-tepisona-hotelska-soba.jpg';
const heroExists = mediaExists(heroSrc);

const highlights = [
	'Velike površine i veći broj komada namještaja',
	'Hoteli, resorti, poslovne zgrade i ustanove',
	'Jednokratni projekti i redovito ugovorno održavanje',
];
---

<section class="hero">
	<div class="hero__media">
		{heroExists ? (
			<img src={heroSrc} alt="Profesionalno čišćenje tepisona profesionalnom opremom u hotelskoj sobi" width="1920" height="1080" loading="eager" fetchpriority="high" />
		) : (
			<MediaPlaceholder title="HERO FOTOGRAFIJA" filename="profesionalno-ciscenje-tepisona-hotelska-soba.jpg" dimensions="1920 × 1080 px" aspectRatio="16/9" fill />
		)}
		<div class="hero__overlay" aria-hidden="true"></div>
		<div class="hero__glow" aria-hidden="true"></div>
	</div>

	<div class="container hero__content">
		<div class="hero__copy">
			<h1>Dubinsko čišćenje tepisona za <span>hotele i poslovne objekte</span></h1>
			<p class="hero__subtitle">Profesionalno dubinsko pranje tepisona (tapisona), velikih podnih površina i većih količina tapeciranog namještaja. Za hotele, tvrtke i ustanove diljem Hrvatske.</p>
			<div class="hero__actions">
				<a href="#kontakt" class="btn btn-primary hero__primary">Zatražite ponudu <span aria-hidden="true">→</span></a>
				<a href="/dubinsko-ciscenje-tepisona/" class="btn btn-outline">Čišćenje tepisona</a>
			</div>
		</div>

		<ul class="hero__highlights">
			{highlights.map((item) => (
				<li><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9.2 16.6-4.3-4.3 1.8-1.8 2.5 2.5 8.1-8.1 1.8 1.8-9.9 9.9Z"/></svg><span>{item}</span></li>
			))}
		</ul>
	</div>

	<a class="hero__scroll" href="#usluge" aria-label="Prijeđite na usluge"><span aria-hidden="true"></span></a>
</section>

<style>
	.hero { position: relative; min-height: clamp(690px, calc(100svh - 122px), 900px); display: flex; align-items: center; color: var(--white); background: #09090b; overflow: hidden; }
	.hero__media, .hero__overlay, .hero__glow { position: absolute; inset: 0; }
	.hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 52% 42%; transform: scale(1.015); animation: hero-reveal 1.1s ease-out both; }
	.hero__overlay { background: linear-gradient(90deg, rgba(7, 7, 9, 0.97) 0%, rgba(7, 7, 9, 0.88) 35%, rgba(7, 7, 9, 0.48) 68%, rgba(7, 7, 9, 0.22) 100%), linear-gradient(0deg, rgba(7, 7, 9, 0.82) 0%, transparent 42%); }
	.hero__glow { inset: auto auto -25% -15%; width: 58%; height: 62%; background: radial-gradient(circle, rgba(227, 30, 36, 0.2), transparent 68%); filter: blur(20px); pointer-events: none; }
	.hero__content { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: center; min-height: inherit; padding-block: clamp(4.5rem, 9vh, 7rem) 2.25rem; }
	.hero__copy { max-width: 790px; animation: content-rise 0.7s 0.15s ease-out both; }
	.hero h1 { max-width: 820px; font-size: clamp(2.7rem, 5.25vw, 5.35rem); font-weight: 900; line-height: 0.98; letter-spacing: -0.055em; text-wrap: balance; }
	.hero h1 span { color: var(--red); }
	.hero__subtitle { margin-top: clamp(1.35rem, 3vh, 2rem); max-width: 660px; font-size: clamp(1rem, 1.35vw, 1.18rem); line-height: 1.65; color: #d2d2d5; }
	.hero__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: clamp(1.7rem, 4vh, 2.5rem); }
	.hero__actions .btn { min-height: 52px; padding-inline: 1.55rem; border-radius: 999px; }
	.hero__primary { box-shadow: 0 12px 30px rgba(227, 30, 36, 0.3); }
	.hero__primary span { font-size: 1.2rem; transition: transform 0.2s ease; }
	.hero__primary:hover span { transform: translateX(3px); }
	.hero__highlights { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: auto; padding-top: clamp(2.5rem, 7vh, 5rem); border-top: 1px solid rgba(255, 255, 255, 0.14); animation: content-rise 0.7s 0.35s ease-out both; }
	.hero__highlights li { display: flex; align-items: flex-start; gap: 0.72rem; padding: 0.3rem clamp(1rem, 2.2vw, 2rem); color: #ededee; font-size: 0.89rem; font-weight: 650; line-height: 1.45; border-right: 1px solid rgba(255, 255, 255, 0.14); }
	.hero__highlights li:first-child { padding-left: 0; }
	.hero__highlights li:last-child { border-right: 0; padding-right: 0; }
	.hero__highlights svg { flex: none; width: 21px; height: 21px; fill: var(--red); }
	.hero__scroll { position: absolute; z-index: 2; right: clamp(1.5rem, 4vw, 4rem); bottom: 2rem; display: grid; place-items: center; width: 42px; height: 58px; border: 1px solid rgba(255, 255, 255, 0.24); border-radius: 999px; }
	.hero__scroll span { width: 4px; height: 10px; border-radius: 999px; background: var(--red); animation: scroll-cue 1.8s ease-in-out infinite; }

	@keyframes hero-reveal { from { opacity: 0.5; transform: scale(1.07); } to { opacity: 1; transform: scale(1.015); } }
	@keyframes content-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: translateY(0); } }
	@keyframes scroll-cue { 0%, 100% { transform: translateY(-5px); opacity: 0.45; } 50% { transform: translateY(6px); opacity: 1; } }

	@media (max-width: 900px) {
		.hero { min-height: 720px; }
		.hero__media img { object-position: 58% 50%; }
		.hero__overlay { background: linear-gradient(90deg, rgba(7, 7, 9, 0.94) 0%, rgba(7, 7, 9, 0.74) 62%, rgba(7, 7, 9, 0.42) 100%), linear-gradient(0deg, rgba(7, 7, 9, 0.9) 0%, transparent 55%); }
		.hero__highlights { gap: 0.8rem; }
		.hero__highlights li { padding-inline: 0 0.8rem; }
		.hero__scroll { display: none; }
	}

	@media (max-width: 640px) {
		.hero { min-height: 700px; align-items: stretch; }
		.hero__media img { object-position: 62% center; }
		.hero__overlay { background: linear-gradient(90deg, rgba(7, 7, 9, 0.93), rgba(7, 7, 9, 0.58)), linear-gradient(0deg, rgba(7, 7, 9, 0.96) 0%, transparent 68%); }
		.hero__content { padding-block: 3.5rem 1.6rem; }
		.hero h1 { font-size: clamp(2.45rem, 12.5vw, 3.6rem); }
		.hero__subtitle { max-width: 34rem; font-size: 1rem; line-height: 1.55; }
		.hero__actions { flex-direction: column; }
		.hero__actions .btn { width: 100%; }
		.hero__highlights { grid-template-columns: 1fr; gap: 0.7rem; padding-top: 1.4rem; }
		.hero__highlights li { padding: 0; border-right: 0; font-size: 0.82rem; }
		.hero__highlights svg { width: 19px; height: 19px; }
	}
</style>
