---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { mediaExists } from '../utils/media';

const heroSrc = '/images/profesionalno-ciscenje-tepisona-hotelska-soba.jpg';
const heroExists = mediaExists(heroSrc);

const highlights = [
	'Više od 10 godina iskustva',
	'Specijalizirana oprema za velike kvadrature',
	'Fleksibilna organizacija rada prema rasporedu klijenta',
];
---

<section class="hero">
	<div class="hero__media">
		{
			heroExists ? (
				<img
					src={heroSrc}
					alt="Profesionalno čišćenje tepisona profesionalnom opremom u hotelskoj sobi"
					width="1920"
					height="1080"
					loading="eager"
					fetchpriority="high"
				/>
			) : (
				<MediaPlaceholder
					title="HERO FOTOGRAFIJA"
					filename="profesionalno-ciscenje-tepisona-hotelska-soba.jpg"
					dimensions="1920 × 1080 px"
					aspectRatio="16/9"
					fill
				/>
			)
		}
		<div class="hero__overlay" aria-hidden="true"></div>
	</div>

	<div class="container hero__content">
		<h1>Profesionalno pranje tepisona i tapaciranog namještaja</h1>
		<p class="hero__subtitle">
			Specijalizirani za velike površine, objekte s puno tepisona i veće količine tapaciranog
			namještaja širom Hrvatske.
		</p>

		<ul class="marker-list hero__highlights">
			{
				highlights.map((item) => (
					<li>
						<span class="marker" aria-hidden="true" />
						{item}
					</li>
				))
			}
		</ul>

		<div class="hero__actions">
			<a href="#kontakt" class="btn btn-primary">Zatražite ponudu</a>
			<a href="#usluge" class="btn btn-outline">Pogledajte usluge</a>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		min-height: 620px;
		display: flex;
		align-items: center;
		color: var(--white);
		overflow: hidden;
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 22% 32%;
	}

	.hero__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgba(17, 17, 17, 0.94) 0%,
			rgba(17, 17, 17, 0.78) 42%,
			rgba(17, 17, 17, 0.35) 75%,
			rgba(17, 17, 17, 0.15) 100%
		);
	}

	.hero__content {
		position: relative;
		z-index: 1;
		max-width: 680px;
		padding-block: 4rem;
	}

	.hero h1 {
		font-size: clamp(2rem, 1.5rem + 2vw, 2.625rem);
	}

	.hero__subtitle {
		margin-top: 1.25rem;
		font-size: 1.1rem;
		color: #e6e6e6;
		max-width: 600px;
	}

	.hero__highlights {
		margin-top: 2rem;
	}

	.hero__highlights li {
		color: var(--white);
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 2.25rem;
	}

	@media (min-width: 901px) {
		.hero__media img {
			object-position: 32% 40%;
		}
	}

	@media (max-width: 640px) {
		.hero {
			min-height: 560px;
		}

		.hero__content {
			padding-block: 3rem;
		}

		.hero__actions .btn {
			width: 100%;
		}
	}
</style>
