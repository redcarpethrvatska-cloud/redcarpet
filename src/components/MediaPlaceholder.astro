---
interface Props {
	title: string;
	filename: string;
	dimensions: string;
	aspectRatio?: string;
	/** Fill the parent container's height instead of enforcing its own aspect ratio (used for full-bleed hero/video slots). */
	fill?: boolean;
}

const { title, filename, dimensions, aspectRatio = '4/3', fill = false } = Astro.props;
---

<div class="media-placeholder" style={fill ? undefined : `aspect-ratio: ${aspectRatio};`} data-fill={fill}>
	<svg class="media-placeholder__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M4 5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H4Zm0 2h16v10H4V7Zm3 1.5A1.5 1.5 0 1 0 7 11.5 1.5 1.5 0 0 0 7 8.5ZM6 17l3.5-4.5 2.5 3 3-4L18 17H6Z"
		></path>
	</svg>
	<p class="media-placeholder__title">{title}</p>
	<p class="media-placeholder__filename">{filename}</p>
	<p class="media-placeholder__dimensions">Preporučeno: {dimensions}</p>
</div>

<style>
	.media-placeholder {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		width: 100%;
		height: 100%;
		min-height: 160px;
		padding: 1.5rem;
		text-align: center;
		background: var(--light-gray);
		border: 1px dashed var(--red);
		color: var(--gray);
	}

	.media-placeholder[data-fill='true'] {
		height: 100%;
	}

	.media-placeholder__icon {
		width: 32px;
		height: 32px;
		color: var(--red);
		margin-bottom: 0.25rem;
	}

	.media-placeholder__title {
		color: var(--black);
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.media-placeholder__filename {
		font-family: ui-monospace, SFMono-Regular, Consolas, 'Liberation Mono', Menlo, monospace;
		font-size: 0.8rem;
		color: var(--red-dark);
		word-break: break-all;
	}

	.media-placeholder__dimensions {
		font-size: 0.78rem;
		color: var(--gray);
	}
</style>
