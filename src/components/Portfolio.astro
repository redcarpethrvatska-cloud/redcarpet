---
const projects = [
 {category:'Hoteli i resorti',title:'Hotelske sobe i hodnici',description:'Dubinsko čišćenje tepisona u smještajnim jedinicama i komunikacijskim prostorima.',photo:'https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=960&q=80'},
 {category:'Ugostiteljstvo',title:'Stolice u hotelskom restoranu',description:'Planirano čišćenje većeg broja tapeciranih stolica i sjedećih površina.',photo:'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=960&q=80'},
 {category:'Poslovni prostori',title:'Uredi i konferencijske dvorane',description:'Organizirano dubinsko čišćenje tepisona i tapeciranog inventara poslovnih objekata.',photo:'https://images.unsplash.com/photo-1497366811353-6870744d04b2?auto=format&fit=crop&w=960&q=80'},
 {category:'Hoteli',title:'Fotelje i garniture u lobiju',description:'Održavanje reprezentativnog tapeciranog namještaja u prostorima s velikim prometom.',photo:'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&w=960&q=80'},
 {category:'Ustanove',title:'Madraci i tekstilna oprema',description:'Usluga za objekte s većim brojem madraca, uz prethodno dogovoren plan rada.',photo:'https://images.unsplash.com/photo-1611892440504-42a792e24d32?auto=format&fit=crop&w=960&q=80'},
 {category:'Poslovni objekti',title:'Tepisoni velikih površina',description:'Strojno dubinsko čišćenje tekstilnih podnih obloga uz prilagodbu radu objekta.',photo:'https://images.unsplash.com/photo-1497366754035-f200968a6e72?auto=format&fit=crop&w=960&q=80'}
];
---
<section class="section portfolio" id="projekti">
 <div class="container">
  <div class="section-heading"><h2>Primjeri projekata i područja rada</h2><p>Pregled područja u kojima pružamo usluge. Prikazane fotografije ilustrativne su i ne predstavljaju dokumentaciju izvedenih radova.</p></div>
  <div class="portfolio__grid">
   {projects.map((project)=>(
    <article class="portfolio__card">
     <img src={project.photo} alt={'Ilustrativni prikaz: '+project.title} loading="lazy" decoding="async" width="960" height="620"/>
     <div class="portfolio__body">
      <span class="portfolio__type">{project.category}</span>
      <h3>{project.title}</h3><p>{project.description}</p>
      <span class="portfolio__sample">Ogledni prikaz – fotografija će biti zamijenjena</span>
     </div>
    </article>
   ))}
  </div>
  <p class="portfolio__action"><a href="/#kontakt" class="btn btn-primary">Pošaljite upit za svoj objekt</a></p>
 </div>
</section>
<style>
.portfolio__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}
.portfolio__card{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:9px;overflow:hidden;background:#fff;box-shadow:0 5px 22px rgba(0,0,0,.045)}
.portfolio__card img{display:block;width:100%;height:220px;object-fit:cover;background:#eee}
.portfolio__body{display:flex;flex-direction:column;flex:1;padding:1.5rem;gap:.2rem}
.portfolio__body h3{margin:.45rem 0 .6rem;font-size:1.28rem;line-height:1.3;min-height:3.3rem}
.portfolio__type{color:var(--red);text-transform:uppercase;letter-spacing:.06em;font-size:.72rem;font-weight:800}
.portfolio__body p{font-size:1rem;line-height:1.6}.portfolio__sample{display:block;margin-top:auto;padding-top:1.3rem;font-size:.82rem;color:#626262}
.portfolio__action{margin-top:2rem;text-align:center}
@media(max-width:980px){.portfolio__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.portfolio__grid{grid-template-columns:1fr}}
</style>
