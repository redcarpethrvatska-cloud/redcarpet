---
import { radovi } from '../data/izvedeniRadovi.js';
const projects = radovi.slice(0, 6);
---
<section class="section portfolio" id="projekti">
 <div class="container">
  <div class="section-heading"><h2>Izvedeni radovi za poslovne klijente</h2><p>Pogledajte fotografije i videozapise izvedenih projekata čišćenja u hotelima, restoranima, konferencijskim centrima i poslovnim objektima.</p></div>
  <div class="portfolio__grid">
   {projects.map((project)=>(
    <article class="portfolio__card">
     <img src={project.images[0]} alt={project.title} loading="lazy" decoding="async" width="960" height="620"/>
     <div class="portfolio__body">
      <span class="portfolio__type">{project.category}</span>
      <h3>{project.title}</h3><p>{project.summary}</p>
      <a class="portfolio__sample" href={"/izvedeni-radovi/"+project.slug+"/"}>Pogledajte projekt →</a>
     </div>
    </article>
   ))}
  </div>
  <p class="portfolio__action"><a href="/izvedeni-radovi/" class="btn btn-primary">Pregledajte članke o radovima</a></p>
 </div>
</section>
<style>
.portfolio__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}
.portfolio__card{display:flex;flex-direction:column;border:1px solid var(--border);border-radius:9px;overflow:hidden;background:#fff;box-shadow:0 5px 22px rgba(0,0,0,.045)}
.portfolio__card img{display:block;width:100%;height:220px;object-fit:cover;background:#eee}
.portfolio__body{display:flex;flex-direction:column;flex:1;padding:1.5rem;gap:.2rem}
.portfolio__body h3{margin:.45rem 0 .6rem;font-size:1.28rem;line-height:1.3;min-height:3.3rem}
.portfolio__type{color:var(--red);text-transform:uppercase;letter-spacing:.06em;font-size:.72rem;font-weight:800}
.portfolio__body p{font-size:1rem;line-height:1.6}.portfolio__sample{display:block;margin-top:auto;padding-top:1.3rem;font-size:.82rem;color:#626262}
.portfolio__action{margin-top:2rem;text-align:center}
@media(max-width:980px){.portfolio__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:620px){.portfolio__grid{grid-template-columns:1fr}}
</style>
