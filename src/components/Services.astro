---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { mediaExists } from '../utils/media';

const services = [
	{
		title: 'Dubinsko čišćenje tepisona',
		href: '/dubinsko-ciscenje-tepisona/',
		text: 'Profesionalno dubinsko i ekstrakcijsko pranje tepisona (tapisona) na velikim površinama hotela, poslovnih zgrada i ustanova.',
		src: '/images/pranje-tepisona-hotelska-soba-red-carpet.jpg',
	},
	{
		title: 'Čišćenje tapeciranog namještaja',
		text: 'Dubinsko čišćenje većeg broja tapeciranih stolica, fotelja i garnitura u hotelskim dvoranama, restoranima i poslovnim objektima.',
		src: '/images/ciscenje-tapaciranog-namjestaja-hotel-restoran.jpg',
	},
	{
		title: 'Madraci u većim količinama',
		text: 'Organizirano dubinsko čišćenje većih količina madraca u hotelima, domovima za starije i drugim smještajnim objektima.',
		src: '/images/pranje-velikih-povrsina-konferencijska-sala.jpg',
	},
	{
		title: 'Impregnacija i zaštita tekstila',
		text: 'Profesionalna zaštita prikladnih fotelja, stolica i garnitura nakon potpunog sušenja ili preventivno na novom namještaju.',
		src: '/images/suho-ciscenje-osjetljivih-povrsina-tepih.jpg',
	},
];

const equipmentSrc = '/images/dubinsko-ciscenje-velike-hotelske-sale-red-carpet.jpg';
const equipmentExists = mediaExists(equipmentSrc);

const equipmentPoints = [
	'Radni doseg približno 40–50 metara',
	'Organizacija rada u etapama',
	'Mogućnost noćnog i vikend rada',
	'Prilagodba vrsti objekta i površine',
];
---

<section class="section services" id="usluge">
	<div class="container">
		<div class="section-heading">
			<h2>Naše usluge</h2>
		</div>

		<div class="services__grid">
			{
				services.map((service) => {
					const exists = mediaExists(service.src);
					return (
						<article class="service-card">
							<div class="service-card__media">
								{exists ? (
									<img src={service.src} alt={service.title} loading="lazy" width="640" height="480" />
								) : (
									<MediaPlaceholder
										title="FOTOGRAFIJA USLUGE"
										filename={service.src.replace('/images/', '')}
										dimensions="1280 × 960 px"
										aspectRatio="4/3"
									/>
								)}
							</div>
							<h3>{service.title}</h3>
							<p>{service.text}</p>
							<a href={service.href || "#kontakt"} class="btn btn-outline-dark service-card__cta">Saznajte više</a>
						</article>
					);
				})
			}
		</div>

		<div class="equipment" id="oprema-organizacija">
			<div class="equipment__media">
				{
					equipmentExists ? (
						<img
							src={equipmentSrc}
							alt="Dubinsko čišćenje velike hotelske dvorane"
							loading="lazy"
							width="900"
							height="675"
						/>
					) : (
						<MediaPlaceholder
							title="FOTOGRAFIJA OPREME"
							filename={equipmentSrc.replace('/images/', '')}
							dimensions="1600 × 1200 px"
							aspectRatio="4/3"
						/>
					)
				}
			</div>

			<div class="equipment__content">
				<h3>Oprema i organizacija za zahtjevne projekte</h3>
				<p>
					Koristimo specijaliziranu profesionalnu opremu koja omogućuje rad na velikim
					površinama i radni doseg približno 40 do 50 metara od položaja stroja. Projekte možemo
					organizirati u etapama, izvan radnog vremena, noću ili vikendom, prema potrebama
					objekta.
				</p>

				<ul class="marker-list equipment__points">
					{
						equipmentPoints.map((point) => (
							<li>
								<span class="marker" aria-hidden="true" />
								{point}
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</div>
</section>

<style>
	.services__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 2rem;
	}

	@media (min-width: 1024px) {
		.services__grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.service-card {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
	}

	.service-card__media {
		border-radius: var(--radius);
		overflow: hidden;
	}

	.service-card__media img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.service-card h3 {
		color: var(--black);
	}

	.service-card p {
		flex: 1;
	}

	.service-card__cta {
		align-self: flex-start;
		margin-top: auto;
	}

	.equipment {
		margin-top: 4rem;
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 3rem;
		align-items: center;
		background: var(--light-gray);
		padding: 2.5rem;
		border-radius: var(--radius);
	}

	.equipment__media img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.equipment__content h3 {
		color: var(--black);
		font-size: 1.5rem;
	}

	.equipment__content p {
		margin-top: 1rem;
	}

	.equipment__points {
		margin-top: 1.5rem;
	}

	@media (max-width: 900px) {
		.equipment {
			grid-template-columns: 1fr;
			padding: 1.75rem;
		}
	}

	@media (max-width: 640px) {
		.services__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}
</style>
