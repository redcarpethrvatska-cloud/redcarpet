---
import MediaPlaceholder from './MediaPlaceholder.astro';
import { mediaExists } from '../utils/media';

const src = '/images/dubinsko-ciscenje-tapacirane-klupe-hotel.jpg';
const exists = mediaExists(src);
---

<section class="section section--light upholstery" id="tapacirani-namjestaj">
	<div class="container upholstery__grid">
		<div class="upholstery__media">
			{
				exists ? (
					<img
						src={src}
						alt="Dubinsko čišćenje tapacirane klupe u hotelu"
						loading="lazy"
						width="900"
						height="675"
					/>
				) : (
					<MediaPlaceholder
						title="FOTOGRAFIJA TAPACIRANOG NAMJEŠTAJA"
						filename="dubinsko-ciscenje-tapacirane-klupe-hotel.jpg"
						dimensions="1600 × 1200 px"
						aspectRatio="4/3"
					/>
				)
			}
		</div>

		<div class="upholstery__content">
			<h2>Čist i svjež tapacirani namještaj</h2>
			<p>
				Profesionalno čistimo stolice, fotelje, sofe, klupe i lounge namještaj u hotelima,
				restoranima, poslovnim objektima, ustanovama, na jahtama i u većim privatnim prostorima.
			</p>
			<p>
				Metodu čišćenja prilagođavamo vrsti materijala, stanju površine i mogućnostima sušenja u
				objektu.
			</p>
			<a href="#kontakt" class="btn btn-outline-dark">Saznajte više</a>
		</div>
	</div>
</section>

<style>
	.upholstery__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: center;
	}

	.upholstery__media img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius);
	}

	.upholstery__content h2 {
		margin-bottom: 1.25rem;
	}

	.upholstery__content p + p {
		margin-top: 1rem;
	}

	.upholstery__content .btn {
		margin-top: 1.75rem;
	}

	@media (max-width: 900px) {
		.upholstery__grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>
