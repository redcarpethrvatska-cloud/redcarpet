---
import '../styles/global.css';
import '../styles/premium-corporate.css';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';

interface Props {
	title?: string;
	description?: string;
  noindex?: boolean;
}

const {
  noindex = false,
	title = 'Dubinsko čišćenje tepisona za hotele i tvrtke | Red Carpet',
	description = 'Profesionalno dubinsko čišćenje tepisona (tapisona), hotelskih i poslovnih podnih površina te većih količina tapeciranog namještaja diljem Hrvatske.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://redcarpet.hr').toString();

const localBusinessJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: 'Red Carpet',
	legalName: 'FERIA obrt za usluge',
	url: canonicalURL,
	telephone: '+385 91 339 3333',
	email: 'redcarpet.hrvatska@gmail.com',
	address: {
		'@type': 'PostalAddress',
		streetAddress: 'Nova Cesta 24a',
		postalCode: '51410',
		addressLocality: 'Opatija',
		addressCountry: 'HR',
	},
	areaServed: 'Hrvatska',
	openingHours: 'Mo-Fr 08:00-16:00',
};
---

<!doctype html>
<html lang="hr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=rc-20261022" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content="hr_HR" />
		<meta property="og:site_name" content="Red Carpet" />

		<script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
	</head>
	<body>
		<a href="#glavni-sadrzaj" class="skip-link">Preskoči na sadržaj</a>
		<slot />
		<AnalyticsConsent />
		<script>
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (!reducedMotion) {
				document.documentElement.classList.add('motion-ready');

				const revealGroups = [
					'main > section',
					'main > article',
					'.services__grid > *',
					'.industry-grid > *',
					'.why-us__grid > *',
					'.portfolio__grid > *',
					'.blog-preview__grid > *',
					'.cases > *',
					'.references__grid > *',
					'.rc-grid > *',
					'.tiles > *',
					'.advice-grid > *',
					'.faq-list > *',
				].join(',');

				const revealItems = Array.from(document.querySelectorAll<HTMLElement>(revealGroups));
				revealItems.forEach((item, index) => {
					item.classList.add('reveal-item');
					item.style.setProperty('--reveal-delay', `${(index % 4) * 70}ms`);
				});

				const revealObserver = new IntersectionObserver(
					(entries, observer) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						});
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
				);

				revealItems.forEach((item) => revealObserver.observe(item));
			}
		</script>
	</body>
</html>

<style is:global>
	html,
	body {
		width: 100%;
	}
</style>
