---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AudienceStrip from '../components/AudienceStrip.astro';
import Services from '../components/Services.astro';
import Industries from '../components/Industries.astro';
import Process from '../components/Process.astro';
import WorkVideo from '../components/WorkVideo.astro';
import WhyUs from '../components/WhyUs.astro';
import Portfolio from '../components/Portfolio.astro';
import UpholsteryFeature from '../components/UpholsteryFeature.astro';
import AboutPreview from '../components/AboutPreview.astro';
import ContactSection from '../components/ContactSection.astro';
import BlogPreview from '../components/BlogPreview.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
	<TopBar />
	<Header />
	<main id="glavni-sadrzaj">
		<Hero />
		<AudienceStrip />
		<Services />
		<Industries />
		<Process />
		<WorkVideo />
		<WhyUs />
		<Portfolio />
		<UpholsteryFeature />
		<AboutPreview />
		<ContactSection />
		<BlogPreview />
	</main>
	<Footer />
</Layout>
