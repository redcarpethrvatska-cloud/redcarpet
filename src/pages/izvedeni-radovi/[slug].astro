---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { radovi } from '../../data/izvedeniRadovi.js';
export function getStaticPaths(){return radovi.map(rad=>({params:{slug:rad.slug},props:{rad}}))}
const {rad}=Astro.props;
---
<Layout title={rad.title+' | Red Carpet'} description={rad.summary}>
<TopBar/><Header/>
<main id="glavni-sadrzaj">
 <article class="section"><div class="container article">
  <p class="article__back"><a href="/izvedeni-radovi/">← Svi primjeri radova</a></p>
  <span class="eyebrow">{rad.category} · izvedeni rad</span>
  <h1>{rad.title}</h1>
  <p class="lead">{rad.summary}</p>
  {rad.images.length > 0 && <figure><a class="gallery__link" href={rad.images[0]} target="_blank" rel="noopener" aria-label="Otvori naslovnu fotografiju u punoj veličini"><img class="hero-img" src={rad.images[0]} alt={rad.imageAlts[0]} width="1200" height="680" loading="eager" fetchpriority="high" decoding="async"/></a><figcaption>Fotografija izvedenih radova Red Carpet</figcaption></figure>}
  <h2>Opis posla</h2><p>{rad.description}</p>
  <h2>Opseg izvedenih radova</h2>
  <ol>{rad.steps.map(step=><li>{step}</li>)}</ol>
  {rad.images.length > 0 && <><h2>Fotografije radova</h2><div class="gallery">{rad.images.map((src,i)=><figure><a class="gallery__link" href={src} target="_blank" rel="noopener" aria-label={`Otvori fotografiju ${i+1} u punoj veličini`}><img src={src} alt={rad.imageAlts[i]} loading="lazy" decoding="async" width="800" height="520"/></a></figure>)}</div></>}
  {rad.videos.length > 0 && <><h2>Videozapisi izvedbe</h2>{rad.videos.map((src,i) => <figure><video controls muted playsinline preload="metadata" poster={rad.images[0]} aria-label={rad.title + " – video " + (i+1)}><source src={src} type="video/mp4"/></video><figcaption>Video izvedbe {i+1}</figcaption></figure>)}</>}
  <a class="btn btn-primary" href="/#kontakt">Zatražite B2B ponudu</a>
 </div></article>
</main><Footer/>
</Layout>
<style>
.article{max-width:920px}.article h1{max-width:820px;margin:.3rem 0 1rem}.article h2{margin:2rem 0 1rem}.article p{line-height:1.7}.article__back{margin-bottom:1.5rem}.lead{font-size:1.2rem;margin-bottom:1.8rem}.article figure{margin:1.5rem 0}.article img{display:block;width:100%;object-fit:cover;border-radius:8px}.hero-img{max-height:480px}.article figcaption{font-size:.83rem;color:#666;margin-top:.5rem}.article ol{list-style:decimal;padding-left:1.5rem}.article li{margin:.65rem 0}.gallery{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem}.gallery__link{display:block;border-radius:8px}.gallery__link:focus-visible{outline:3px solid #e31e24;outline-offset:4px}.gallery img{aspect-ratio:3/2}.notice{background:#f5f5f5;border-left:3px solid #e31e24;padding:1rem;margin:1.5rem 0}.article video{display:block;width:100%;max-height:480px;aspect-ratio:16/9;object-fit:contain;background:#111}.gallery figure{content-visibility:auto;contain-intrinsic-size:auto 320px}@media(max-width:650px){.gallery{grid-template-columns:1fr}}
</style>
