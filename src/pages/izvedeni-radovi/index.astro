---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { radovi } from '../../data/izvedeniRadovi.js';

const referenceGroups = [
	{
		title: 'Hoteli, restorani i konferencijski centri',
		text: 'Čišćenje tepisona u hotelskim sobama, hodnicima i restoranima, te održavanje većeg broja tapeciranih stolica, separea i namještaja. Pri planiranju je posebno važna dostupnost prostorija i usklađivanje s rasporedom gostiju ili događanja.',
	},
	{
		title: 'Upravne zgrade i poslovni prostori',
		text: 'Dokumentirani projekti površine oko 400 m² i 800 m² uključuju urede, hodnike i druge prometne zone. Za procjenu se uzima u obzir raspored etaža, vrsta obloge te pristup radnim prostorijama.',
	},
	{
		title: 'Velike količine tapeciranog namještaja',
		text: 'Prikazujemo i projekte čišćenja oko 300 restoranskih stolica te čišćenja ili impregnacije 550 konferencijskih stolica. Prikladnost postupka provjerava se prema materijalu i stanju presvlaka.',
	},
];

const faqs = [
	{
		question: 'Čistite li tepisone u cijeloj Hrvatskoj?',
		answer: 'Da, veće B2B projekte moguće je dogovoriti diljem Hrvatske, ovisno o lokaciji, opsegu i raspoloživosti termina.',
	},
	{
		question: 'Može li se čišćenje organizirati noću ili vikendom?',
		answer: 'Prema dogovoru i raspoloživosti, radove je moguće planirati izvan redovnog radnog vremena ili u etapama.',
	},
	{
		question: 'Koliko traje sušenje tepisona?',
		answer: 'Vrijeme ovisi o materijalu, metodi čišćenja, ventilaciji i temperaturi. Točan plan korištenja prostora dogovara se prije početka radova.',
	},
	{
		question: 'Čistite li i manji broj privatnih tepiha?',
		answer: 'Ne. Fokus Red Carpeta su velike poslovne površine i veće količine namještaja u hotelima, tvrtkama i ustanovama.',
	},
];
---

<Layout
	title="Izvedeni radovi – čišćenje tepisona za hotele | Red Carpet"
	description="Pogledajte 15 izvedenih B2B projekata čišćenja tepisona, stolica i hotelskih prostora. Reference iz hotela, ureda i konferencijskih dvorana."
>
	<TopBar />
	<Header />
	<main id="glavni-sadrzaj">
		<section class="portfolio-intro">
			<div class="container">
				<span class="eyebrow">Red Carpet · B2B portfolio</span>
				<h1>Izvedeni radovi – profesionalno dubinsko čišćenje tepisona u hotelima i poslovnim objektima</h1>
				<div class="portfolio-intro__copy">
					<p>Red Carpet specijaliziran je za profesionalno dubinsko i kemijsko čišćenje tepisona u hotelima, poslovnim zgradama, restoranima, konferencijskim centrima i drugim velikim objektima diljem Hrvatske.</p>
					<p>Na ovoj stranici predstavljamo stvarne projekte čišćenja velikih površina, od hotelskih hodnika i uredskih prostora do konferencijskih dvorana i tapeciranog namještaja u većim količinama. Među izvedenim projektima nalaze se čišćenje približno 800 m² tepisona u upravnoj zgradi, čišćenje 550 konferencijskih stolica i dubinsko čišćenje 500 m² bijelog tepiha u jednom danu.</p>
					<p>Svaki prostor ima drukčije zahtjeve. Prije izrade ponude uzimamo u obzir vrstu podne obloge, površinu, raspored prostora i mogućnost pristupa. Radove prema dogovoru organiziramo u etapama, izvan redovnog radnog vremena, noću ili vikendom, uz planiranje potrebnog vremena za sušenje.</p>
					<p>U galeriji pogledajte 15 stvarnih primjera radova i odaberite projekt najsličniji vašem objektu. Red Carpet usmjeren je na B2B klijente i veće količine, a ne na pojedinačno pranje kućnih tepiha.</p>
				</div>
			</div>
		</section>

		<section class="section references">
			<div class="container">
				<div class="section-heading"><h2>Što pokazuju naše reference?</h2></div>
				<div class="references__grid">
					{referenceGroups.map((group, index) => (
						<article><span aria-hidden="true">0{index + 1}</span><h3>{group.title}</h3><p>{group.text}</p></article>
					))}
				</div>
			</div>
		</section>

		<section class="section section--light projects-section">
			<div class="container">
				<div class="section-heading"><span class="eyebrow">15 stvarnih projekata</span><h2>Galerija izvedenih radova</h2></div>
				<div class="cases">
					{radovi.map((rad) => (
						<article class="case">
							<a href={`/izvedeni-radovi/${rad.slug}/`}>
								{rad.images.length > 0 ? (
									<img src={rad.images[0]} alt={rad.imageAlts[0]} loading="lazy" decoding="async" width="800" height="500" />
								) : (
									<div class="case__placeholder" aria-hidden="true"><span>RED CARPET</span></div>
								)}
								<div class="case__body"><span class="eyebrow">{rad.category}</span><h3>{rad.h1}</h3><p>{rad.summary}</p><span class="case__more">Pogledajte projekt →</span></div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section quote-section">
			<div class="container quote-section__inner">
				<div><span class="eyebrow">Individualna procjena</span><h2>Kako zatražiti ponudu za vaš objekt?</h2><p>Pošaljite lokaciju, okvirnu kvadraturu tepisona ili broj stolica, fotografije te željeni termin radova. Na temelju opsega i uvjeta pristupa izrađuje se individualna B2B ponuda.</p></div>
				<a class="btn btn-primary" href="/#kontakt">Zatražite ponudu za čišćenje velikih površina</a>
			</div>
		</section>

		<section class="section section--light faq-section">
			<div class="container faq-section__inner">
				<div class="section-heading"><span class="eyebrow">Najčešća pitanja</span><h2>Informacije prije slanja upita</h2></div>
				<div class="faq-list">
					{faqs.map((faq) => <article><h3>{faq.question}</h3><p>{faq.answer}</p></article>)}
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	.portfolio-intro { padding-block: clamp(4rem, 8vw, 7rem); background: #101012; color: #fff; }
	.portfolio-intro h1 { max-width: 1050px; font-size: clamp(2.35rem, 4.5vw, 4.5rem); line-height: 1.04; }
	.portfolio-intro__copy { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem 3rem; max-width: 1100px; margin-top: 2rem; }
	.portfolio-intro__copy p { color: #c7c7ca; }
	.references__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.2rem; }
	.references article { padding: 1.6rem; border: 1px solid var(--border); border-radius: 12px; }
	.references article > span { display: block; margin-bottom: 1rem; color: var(--red); font-size: 1.7rem; font-weight: 900; }
	.references h3 { margin-bottom: 0.7rem; }
	.cases { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
	.case { overflow: hidden; border: 1px solid var(--border); border-radius: 12px; background: #fff; content-visibility: auto; contain-intrinsic-size: auto 430px; transition: transform 0.22s ease, box-shadow 0.22s ease; }
	.case:hover { transform: translateY(-4px); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.1); }
	.case a { display: block; height: 100%; color: inherit; text-decoration: none; }
	.case img { display: block; width: 100%; height: 220px; object-fit: cover; }
	.case__placeholder { display: flex; align-items: center; justify-content: center; height: 220px; background: #252528; color: #fff; font-weight: 700; letter-spacing: 0.18em; }
	.case__body { padding: 1.4rem; }
	.case h3 { margin: 0.35rem 0 0.7rem; font-size: 1.22rem; }
	.case p { font-size: 0.96rem; }
	.case__more { display: block; margin-top: 1rem; color: var(--red); font-weight: 800; }
	.quote-section { background: #171719; color: #fff; }
	.quote-section__inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; }
	.quote-section h2 { margin-bottom: 0.8rem; }
	.quote-section p { max-width: 760px; color: #c7c7ca; }
	.quote-section .btn { flex: none; max-width: 340px; white-space: normal; text-align: center; line-height: 1.25; }
	.faq-section__inner { display: grid; grid-template-columns: 0.75fr 1.25fr; gap: 3rem; }
	.faq-list { display: grid; gap: 1rem; }
	.faq-list article { padding: 1.35rem 1.5rem; border-radius: 10px; background: #fff; }
	.faq-list h3 { margin-bottom: 0.45rem; }

	@media (max-width: 900px) {
		.portfolio-intro__copy, .references__grid, .faq-section__inner { grid-template-columns: 1fr; }
		.cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.quote-section__inner { flex-direction: column; align-items: flex-start; }
	}

	@media (max-width: 620px) {
		.cases { grid-template-columns: 1fr; }
		.quote-section .btn { width: 100%; max-width: none; }
	}
</style>
