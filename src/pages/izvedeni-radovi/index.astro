---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {radovi} from '../../data/izvedeniRadovi.js';
---
<Layout noindex={true} title="Primjeri radova i studije slučaja | Red Carpet" description="Stvarni B2B projekti Red Carpeta: dubinsko čišćenje tepisona, namještaja i velikih tekstilnih površina.">
<TopBar/><Header/>
<main id="glavni-sadrzaj"><section class="section"><div class="container">
 <div class="section-heading"><span class="eyebrow">Red Carpet · B2B portfolio</span><h1>Izvedeni radovi – galerija projekata</h1><p>Pogledajte stvarne projekte profesionalnog dubinskog čišćenja za hotele, konferencijske centre, restorane i poslovne objekte.</p></div>
 <div class="cases">{radovi.map(rad=><article class="case"><a href={'/izvedeni-radovi/'+rad.slug+'/'}>{rad.images.length > 0 ? <img src={rad.images[0]} alt={rad.title} loading="lazy" decoding="async" width="800" height="500"/> : <div class="case__placeholder" aria-hidden="true"><span>RED CARPET</span></div>}<div class="case__body"><span class="eyebrow">{rad.category}</span><h2>{rad.title}</h2><p>{rad.summary}</p><span class="case__more">Pogledajte projekt →</span></div></a></article>)}</div>
 </div></section></main><Footer/>
</Layout>
<style>
.cases{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.case{border:1px solid var(--border);border-radius:9px;overflow:hidden;background:#fff}.case a{color:inherit;text-decoration:none;display:block;height:100%}.case{content-visibility:auto;contain-intrinsic-size:auto 370px}.case img{display:block;width:100%;height:210px;object-fit:cover}.case__placeholder{height:210px;background:#252528;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;letter-spacing:.18em}.case__body{padding:1.4rem}.case h2{font-size:1.22rem;margin:.35rem 0 .7rem}.case p{font-size:1rem}.case__more{display:block;margin-top:1rem;color:var(--red);font-weight:700}.notice{margin-top:2rem;padding:1rem;background:#f4f4f4;border-left:3px solid var(--red)}@media(max-width:900px){.cases{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.cases{grid-template-columns:1fr}}
</style>