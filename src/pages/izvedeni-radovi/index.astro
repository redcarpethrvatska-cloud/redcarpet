---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import {radovi} from '../../data/izvedeniRadovi.js';
---
<Layout noindex={true} title="Primjeri radova i studije slučaja | Red Carpet" description="Ogledni prikazi profesionalnog čišćenja hotelskih i poslovnih tekstilnih površina.">
<TopBar/><Header/>
<main id="glavni-sadrzaj"><section class="section"><div class="container">
 <div class="section-heading"><span class="eyebrow">Red Carpet · B2B portfolio</span><h1>Izvedeni radovi – galerija projekata</h1><p>Ovdje ćemo objavljivati potvrđene projekte s opisom posla, fotografijama i videozapisom. Trenutačni članci su ogledni primjeri izgleda, ne tvrdnje o izvedenim poslovima.</p></div>
 <div class="cases">{radovi.map(rad=><article class="case"><a href={'/izvedeni-radovi/'+rad.slug+'/'}><img src={rad.images[0]} alt={'Ilustrativno: '+rad.title} loading="lazy" width="800" height="500"/><div class="case__body"><span class="eyebrow">{rad.category}</span><h2>{rad.title}</h2><p>{rad.summary}</p><span class="case__more">Pročitaj ogledni članak →</span></div></a></article>)}</div>
 <p class="notice">Fotografije su ilustrativne. Sadržaje ćemo zamijeniti stvarnim radovima prije njihove javne objave.</p>
 </div></section></main><Footer/>
</Layout>
<style>
.cases{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.5rem}.case{border:1px solid var(--border);border-radius:9px;overflow:hidden;background:#fff}.case a{color:inherit;text-decoration:none;display:block;height:100%}.case img{display:block;width:100%;height:210px;object-fit:cover}.case__body{padding:1.4rem}.case h2{font-size:1.22rem;margin:.35rem 0 .7rem}.case p{font-size:1rem}.case__more{display:block;margin-top:1rem;color:var(--red);font-weight:700}.notice{margin-top:2rem;padding:1rem;background:#f4f4f4;border-left:3px solid var(--red)}@media(max-width:900px){.cases{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.cases{grid-template-columns:1fr}}
</style>