import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactSection from '../components/ContactSection.astro';
const faqs = [{"question":"Radite li dubinsko čišćenje tepisona u Zagrebu?","answer":"Da. Red Carpet izvodi veće B2B projekte u Zagrebu i drugim dijelovima Hrvatske, uz dogovor o opsegu i terminu."},{"question":"Možete li raditi noću ili vikendom?","answer":"Da, prema dogovoru i raspoloživosti, ovisno o projektu i pristupu prostoru."},{"question":"Koliko kvadrata možete očistiti u jednom danu?","answer":"Okvirno oko 500 m² u prikladnim uvjetima. Stvarni opseg ovisi o zaprljanju, materijalu, pripremi i organizaciji."},{"question":"Koliko traje sušenje nakon pranja tepisona?","answer":"Ovisi o materijalu, tehnici, temperaturi i ventilaciji. Procjenu dajemo za konkretan objekt."},{"question":"Čistite li privatne tepihe?","answer":"Ne. Fokus je na hotelima, uredima, konferencijskim dvoranama i velikim poslovnim površinama."}];
const structuredData = {
 '@context':'https://schema.org','@graph':[
  {'@type':'Service',name:'Dubinsko čišćenje tepisona Zagreb – B2B',serviceType:'Profesionalno strojno i dubinsko čišćenje tepisona u poslovnim prostorima',provider:{'@type':'LocalBusiness',name:'Red Carpet',url:'https://redcarpet.hr/'},areaServed:{'@type':'City',name:'Zagreb'},audience:{'@type':'BusinessAudience'},url:'https://redcarpet.hr/pranje-tepisona-zagreb/'},
