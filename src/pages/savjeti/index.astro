---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { advicePosts } from '../../data/advicePosts.js';

const newsPosts = [
  {
    title: 'Profesionalno dubinsko čišćenje hotela i poslovnih prostora',
    description: 'Kako organizirati profesionalno čišćenje tepisona i tapeciranog namještaja u hotelima, uredima i konferencijskim centrima.',
    image: '/images/red-carpet-dubinsko-ciscenje-stepenista-novosti.webp',
    href: '/novosti/profesionalno-dubinsko-ciscenje-hotela-i-poslovnih-prostora/',
    category: 'Novosti',
  },
];
const posts = [
  ...newsPosts,
  ...advicePosts.map(post => ({
    title: post.title,
    description: post.description,
    image: post.image,
    href: `/savjeti/${post.slug}/`,
    category: 'Savjeti',
  })),
];
---
<Layout
  title="Savjeti i novosti – čišćenje tepisona za hotele i tvrtke | Red Carpet"
  description="B2B savjeti i novosti o dubinskom čišćenju tepisona, hotelskog namještaja, konferencijskih dvorana i poslovnih površina. Reference i vodiči Red Carpet."
>
  <TopBar />
  <Header />
  <main id="glavni-sadrzaj">
    <section class="section">
      <div class="container">
        <h1>Savjeti i novosti</h1>
        <p>Stručni vodiči i novosti o održavanju velikih tekstilnih površina u hotelima, konferencijskim centrima i poslovnim objektima.</p>
        <div class="advice-grid">
          {posts.map(post => (
            <article>
              <a href={post.href}>
                <img src={post.image} alt={post.title} width="720" height="480" loading="lazy" decoding="async" />
                <div class="body">
                  <span class="category">{post.category}</span>
                  <h2>{post.title}</h2>
                  <p>{post.description}</p>
                  <span>Pročitaj {post.category === 'Novosti' ? 'novost' : 'savjet'} →</span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<style>
  .advice-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; margin-top:2rem; }
  .advice-grid article { border:1px solid var(--border); border-radius:8px; overflow:hidden; }
  .advice-grid a { display:block; color:inherit; text-decoration:none; height:100%; }
  .advice-grid a:hover h2 { color:var(--red); }
  .advice-grid img { width:100%; aspect-ratio:3/2; object-fit:cover; display:block; }
  .body { padding:1.2rem; }
  .body h2 { font-size:1.2rem; }
  .body p { line-height:1.6; }
  .body span { color:var(--red); font-weight:700; }
  .category { display:inline-block; margin-bottom:.5rem; font-size:.8rem; text-transform:uppercase; letter-spacing:.04em; }
  @media(max-width:850px) { .advice-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:600px) { .advice-grid { grid-template-columns:1fr; } }
</style>